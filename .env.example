# @yohangel/auth
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://user:password@localhost:5432/app
# Optional
APP_NAME=My App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_TRUSTED_ORIGINS=      # e.g. https://app.example.com (SPA on another origin)
AUTH_IP_HEADER=            # e.g. cf-connecting-ip behind Cloudflare
